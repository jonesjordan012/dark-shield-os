{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://darkshield.dev/schemas/universe.schema.json",
  "title": "Dark Shield Universe",
  "type": "object",
  "required": [
    "schema_version",
    "universe_id",
    "nodes",
    "relationships",
    "history"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "universe_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_at": {
      "type": "string",
      "format": "date-time"
    },
    "meta": {
      "$ref": "#/definitions/meta"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/node"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/relationship"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/historyEvent"
      }
    },
    "metrics": {
      "$ref": "#/definitions/metrics"
    },
    "validators": {
      "$ref": "#/definitions/validators"
    }
  },
  "definitions": {
    "meta": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "kernel": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "scan_duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "star",
            "pulsar",
            "neutron_star",
            "galaxy",
            "temporal_echo"
          ]
        },
        "subtype": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "inactive",
            "archived",
            "deleted",
            "unknown"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true
        },
        "canonical": {
          "type": "boolean",
          "description": "True if this node is canonical reality. Mutually exclusive with derived."
        },
        "derived": {
          "type": "boolean",
          "description": "True if this node is a derived view/cache. Mutually exclusive with canonical."
        },
        "classification": {
          "type": "object",
          "description": "How this node came to be classified. M1: source=filesystem only.",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "filesystem",
                "inference",
                "declared"
              ],
              "description": "filesystem: observed structurally (M1). inference: assigned by analysis (M3+). declared: named by the user (sovereign act)."
            },
            "kind": {
              "type": "string",
              "description": "M1 kinds: directory, application, workspace. M3 kinds: development, research, communication, learning, creativity."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "relation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "relation": {
          "type": "string",
          "enum": [
            "contains",
            "depends_on",
            "uses",
            "runs_on",
            "executes",
            "related_to",
            "belongs_to",
            "inherits_from",
            "split_into",
            "merged_from",
            "generated_echo",
            "same_directory",
            "shared_parent_directory",
            "shared_extension",
            "shared_name_stem",
            "duplicate_candidate",
            "temporal_neighbor",
            "derived_from",
            "unknown"
          ]
        },
        "weight": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/definitions/evidence"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/evidence"
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "observations": {
          "type": "integer",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": true
    },
    "historyEvent": {
      "description": "Two legal shapes: the M1 legacy event and the enveloped event (RAC-002 Section 7 / DG-0). Legacy files validate unchanged.",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "entity_id",
            "event",
            "timestamp"
          ],
          "properties": {
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "entity_id": {
              "type": "string"
            },
            "event": {
              "type": "string"
            },
            "data": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "event_id",
            "event_type",
            "timestamp",
            "schema_version"
          ],
          "properties": {
            "event_id": {
              "type": "string"
            },
            "event_type": {
              "type": "string"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "schema_version": {
              "type": "string"
            },
            "scanner_version": {
              "type": "string"
            },
            "observation_id": {
              "type": "string"
            },
            "entity_id": {
              "type": "string"
            },
            "star_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "metrics": {
      "type": "object",
      "properties": {
        "stars": {
          "type": "integer",
          "minimum": 0
        },
        "pulsars": {
          "type": "integer",
          "minimum": 0
        },
        "galaxies": {
          "type": "integer",
          "minimum": 0
        },
        "relationships": {
          "type": "integer",
          "minimum": 0
        },
        "continuity_average": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      },
      "additionalProperties": true
    },
    "validators": {
      "type": "object",
      "properties": {
        "orphan_nodes": {
          "type": "integer",
          "minimum": 0
        },
        "broken_edges": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_ids": {
          "type": "integer",
          "minimum": 0
        },
        "integrity_status": {
          "type": "string",
          "enum": [
            "pass",
            "warning",
            "fail"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
