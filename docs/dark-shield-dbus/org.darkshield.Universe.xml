<!DOCTYPE node PUBLIC
"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<node name="/org/darkshield/universe">

  <interface name="org.darkshield.Universe">

    <method name="GetUniverseState">
      <arg name="state" type="s" direction="out"/>
    </method>

    <method name="GetUniverseMetrics">
      <arg name="metrics" type="a{sv}" direction="out"/>
    </method>

    <method name="ListGalaxies">
      <arg name="galaxies" type="as" direction="out"/>
    </method>

    <method name="GetGalaxy">
      <arg name="galaxy_id" type="s" direction="in"/>
      <arg name="galaxy" type="a{sv}" direction="out"/>
    </method>

    <method name="ReloadUniverse"/>

    <property name="UniverseId" type="s" access="read"/>
    <property name="PersistentBoot" type="b" access="read"/>

    <signal name="UniverseChanged">
      <arg name="universe_id" type="s"/>
    </signal>

    <signal name="GalaxyCreated">
      <arg name="galaxy_id" type="s"/>
    </signal>

    <signal name="GalaxyRemoved">
      <arg name="galaxy_id" type="s"/>
    </signal>

  </interface>

</node>
