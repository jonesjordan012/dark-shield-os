<!DOCTYPE node PUBLIC
"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<node name="/org/darkshield/moonlight">

  <interface name="org.darkshield.Moonlight">

    <method name="CreateUniverse">
      <arg name="template" type="s" direction="in"/>
      <arg name="strategy" type="s" direction="in"/>
      <arg name="universe_id" type="s" direction="out"/>
    </method>

    <method name="DestroyUniverse">
      <arg name="universe_id" type="s" direction="in"/>
    </method>

    <method name="PauseUniverse">
      <arg name="universe_id" type="s" direction="in"/>
    </method>

    <method name="ResumeUniverse">
      <arg name="universe_id" type="s" direction="in"/>
    </method>

    <method name="GetUniverseStatus">
      <arg name="universe_id" type="s" direction="in"/>
      <arg name="status" type="a{sv}" direction="out"/>
    </method>

    <method name="ListUniverses">
      <arg name="universes" type="as" direction="out"/>
    </method>

    <method name="PromoteUniverse">
      <arg name="universe_id" type="s" direction="in"/>
      <arg name="accepted" type="b" direction="out"/>
    </method>

    <signal name="UniverseCreated">
      <arg name="universe_id" type="s"/>
    </signal>

    <signal name="UniverseFailed">
      <arg name="universe_id" type="s"/>
    </signal>

    <signal name="UniverseReadyForPromotion">
      <arg name="universe_id" type="s"/>
    </signal>

  </interface>

</node>
