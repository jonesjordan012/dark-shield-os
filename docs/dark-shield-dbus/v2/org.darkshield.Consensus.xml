<!DOCTYPE node PUBLIC
"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<!--
  Dark Shield D-Bus API v2 — Consensus
  Error contract (org.darkshield.Error.*):
    NotFound, InvalidUniverse, AnchorViolation,
    ResourceExhausted, PermissionDenied, EclipseRequired
  v2 change: EvaluatePromotion added for the three-way promotion handshake:
    Moonlight.RequestPromotion → Consensus.EvaluatePromotion → Anchor.ApprovePromotion
-->

<node name="/org/darkshield/consensus">

  <interface name="org.darkshield.Consensus">

    <method name="EvaluateUniverses">
      <arg name="universes" type="as" direction="in"/>
      <arg name="decision" type="a{sv}" direction="out"/>
    </method>

    <method name="CompareUniverses">
      <!-- Errors: org.darkshield.Error.NotFound -->
      <arg name="universe_a" type="s" direction="in"/>
      <arg name="universe_b" type="s" direction="in"/>
      <arg name="result" type="a{sv}" direction="out"/>
    </method>

    <method name="GetWinner">
      <arg name="candidates" type="as" direction="in"/>
      <arg name="winner" type="s" direction="out"/>
    </method>

    <method name="EvaluatePromotion">
      <!-- Evaluates a promotion request opened by Moonlight.RequestPromotion.
           Errors: org.darkshield.Error.NotFound -->
      <arg name="request_id" type="s" direction="in"/>
      <arg name="evaluation" type="a{sv}" direction="out"/>
    </method>

    <signal name="ConsensusReached">
      <arg name="universe_id" type="s"/>
      <arg name="confidence" type="d"/>
    </signal>

    <signal name="PromotionEvaluated">
      <arg name="request_id" type="s"/>
      <arg name="confidence" type="d"/>
    </signal>

  </interface>

  <interface name="org.freedesktop.DBus.Introspectable">
    <method name="Introspect">
      <arg name="xml_data" type="s" direction="out"/>
    </method>
  </interface>

  <interface name="org.freedesktop.DBus.Properties">
    <method name="Get">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="property_name" type="s" direction="in"/>
      <arg name="value" type="v" direction="out"/>
    </method>
    <method name="Set">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="property_name" type="s" direction="in"/>
      <arg name="value" type="v" direction="out"/>
    </method>
    <method name="GetAll">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="properties" type="a{sv}" direction="out"/>
    </method>
    <signal name="PropertiesChanged">
      <arg name="interface_name" type="s"/>
      <arg name="changed_properties" type="a{sv}"/>
      <arg name="invalidated_properties" type="as"/>
    </signal>
  </interface>

  <interface name="org.freedesktop.DBus.Peer">
    <method name="Ping"/>
    <method name="GetMachineId">
      <arg name="machine_id" type="s" direction="out"/>
    </method>
  </interface>

</node>
