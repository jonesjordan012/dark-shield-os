<!DOCTYPE node PUBLIC
"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<!--
  Dark Shield D-Bus API v2 — Anchor
  Error contract (org.darkshield.Error.*):
    NotFound, InvalidUniverse, AnchorViolation,
    ResourceExhausted, PermissionDenied, EclipseRequired
  v2 change: ApprovePromotion now takes the promotion request_id from the
  three-way handshake (Moonlight.RequestPromotion → Consensus.EvaluatePromotion
  → Anchor.ApprovePromotion). The Anchor is the sole approver; nothing crosses
  from a Moon Universe into the Sun Universe without it.
-->

<node name="/org/darkshield/anchor">

  <interface name="org.darkshield.Anchor">

    <method name="VerifyState">
      <!-- Errors: org.darkshield.Error.NotFound -->
      <arg name="universe_id" type="s" direction="in"/>
      <arg name="trusted" type="b" direction="out"/>
    </method>

    <method name="ApprovePromotion">
      <!-- Sole approval authority for Moon → Sun promotion.
           Errors: org.darkshield.Error.NotFound, org.darkshield.Error.AnchorViolation,
                    org.darkshield.Error.PermissionDenied -->
      <arg name="request_id" type="s" direction="in"/>
      <arg name="approved" type="b" direction="out"/>
    </method>

    <method name="LockAnchor">
      <!-- Errors: org.darkshield.Error.NotFound, org.darkshield.Error.PermissionDenied -->
      <arg name="anchor_id" type="s" direction="in"/>
    </method>

    <method name="UnlockAnchor">
      <!-- Errors: org.darkshield.Error.NotFound, org.darkshield.Error.PermissionDenied -->
      <arg name="anchor_id" type="s" direction="in"/>
    </method>

    <method name="GetAnchorStatus">
      <arg name="status" type="a{sv}" direction="out"/>
    </method>

    <signal name="AnchorViolationDetected">
      <arg name="anchor_id" type="s"/>
    </signal>

    <signal name="PromotionApproved">
      <arg name="request_id" type="s"/>
      <arg name="universe_id" type="s"/>
    </signal>

    <signal name="PromotionRejected">
      <arg name="request_id" type="s"/>
      <arg name="universe_id" type="s"/>
      <arg name="reason" type="s"/>
    </signal>

  </interface>

  <interface name="org.freedesktop.DBus.Introspectable">
    <method name="Introspect">
      <arg name="xml_data" type="s" direction="out"/>
    </method>
  </interface>

  <interface name="org.freedesktop.DBus.Properties">
    <method name="Get">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="property_name" type="s" direction="in"/>
      <arg name="value" type="v" direction="out"/>
    </method>
    <method name="Set">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="property_name" type="s" direction="in"/>
      <arg name="value" type="v" direction="out"/>
    </method>
    <method name="GetAll">
      <arg name="interface_name" type="s" direction="in"/>
      <arg name="properties" type="a{sv}" direction="out"/>
    </method>
    <signal name="PropertiesChanged">
      <arg name="interface_name" type="s"/>
      <arg name="changed_properties" type="a{sv}"/>
      <arg name="invalidated_properties" type="as"/>
    </signal>
  </interface>

  <interface name="org.freedesktop.DBus.Peer">
    <method name="Ping"/>
    <method name="GetMachineId">
      <arg name="machine_id" type="s" direction="out"/>
    </method>
  </interface>

</node>
