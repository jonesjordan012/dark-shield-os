<!DOCTYPE node PUBLIC
"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">

<node name="/org/darkshield/anchor">

  <interface name="org.darkshield.Anchor">

    <method name="VerifyState">
      <arg name="universe_id" type="s" direction="in"/>
      <arg name="trusted" type="b" direction="out"/>
    </method>

    <method name="ApprovePromotion">
      <arg name="universe_id" type="s" direction="in"/>
      <arg name="approved" type="b" direction="out"/>
    </method>

    <method name="LockAnchor">
      <arg name="anchor_id" type="s" direction="in"/>
    </method>

    <method name="UnlockAnchor">
      <arg name="anchor_id" type="s" direction="in"/>
    </method>

    <method name="GetAnchorStatus">
      <arg name="status" type="a{sv}" direction="out"/>
    </method>

    <signal name="AnchorViolationDetected">
      <arg name="anchor_id" type="s"/>
    </signal>

    <signal name="PromotionApproved">
      <arg name="universe_id" type="s"/>
    </signal>

    <signal name="PromotionRejected">
      <arg name="universe_id" type="s"/>
    </signal>

  </interface>

</node>
